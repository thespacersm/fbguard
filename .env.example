# ------------------------------------------------------------------
# fbguard - configurazione
# Riletta a ogni richiesta: dopo una modifica non serve riavviare nulla.
# ------------------------------------------------------------------

# Interruttore generale. A 0 il sito si comporta come se fbguard non ci fosse.
ENABLED=1

# OBBLIGATORIO. Base URL dell'origin da cui il worker scarica le pagine.
# Se resta vuoto il guard non fa nulla (fail-open).
ORIGIN_BASE=https://esempio.it

# Opzionale ma consigliato: IP a cui risolvere l'host, per evitare che il
# worker faccia il giro esterno passando da Cloudflare. Es. 127.0.0.1
# Il certificato resta valido: l'SNI usa comunque l'hostname.
ORIGIN_RESOLVE=

# ------------------------------------------------------------------
# Cache
# ------------------------------------------------------------------

# TTL delle risposte buone, in secondi. Default 30 giorni.
TTL=2592000

# TTL delle risposte di errore (404, 5xx). Corto di proposito: non vogliamo
# congelare per un mese un errore temporaneo.
TTL_ERROR=3600

# Quanto una cache condivisa (Cloudflare) puo' tenersi una copia SCADUTA
# mentre il cron la rigenera. Senza questo il residuo sarebbe zero e il bordo
# smetterebbe di fare da scudo proprio nella finestra di rigenerazione:
# ogni richiesta arriverebbe fino a fbguard finche' il cron non passa.
# Metti 0 per disattivare.
STALE_MAX_AGE=60

# Comprime il corpo su disco con gzip (l'HTML intero pesa parecchio) e lo
# serve gia' compresso ai client che accettano gzip.
GZIP=1

# Risorse che non vanno MAI messe in cache, perche' devono restare fresche:
# robots.txt, sitemap, feed. Vengono lasciate generare a WordPress.
PASSTHROUGH_EXTS=xml,json,txt,rss,atom

# Prefisso che la Transform Rule di Cloudflare antepone al path per gli
# scraper, cosi' che al bordo abbiano una cache key separata da quella degli
# utenti veri (Cloudflare VIETA di mettere lo user agent nella cache key).
# fbguard lo toglie e lavora sulla URL reale. Deve combaciare con la regola CF.
EDGE_PREFIX=/__fbguard

# ------------------------------------------------------------------
# Chi attiva il guard
# ------------------------------------------------------------------

# Sottostringhe dello user agent, case-insensitive, separate da virgola.
#
# "facebook" e "meta" nudi: scelta deliberata, verificata sui dati reali di
# Cloudflare (6h, campione di 113.536 richieste):
#   23.399 UA contengono facebook/meta  →  23.322 scraper + 77 meta-webindexer
#   falsi positivi su utenti veri: ZERO
# I browser in-app di Facebook e Instagram si identificano con FBAN / FBAV /
# FB_IAB / FB4A e NON contengono le parole "facebook" o "meta", quindi i
# clienti che cliccano un'inserzione passano sempre da WordPress.
#
# Il match largo copre anche le varianti che Meta aggiunge nel tempo
# (meta-externalagent, meta-externalads, meta-externalfetcher, meta-webindexer,
# facebookexternalhit, facebookcatalog, facebookbot...) senza doverle inseguire.
# Nota: meta-externalagent si maschera da Chrome e mette il proprio nome in
# fondo allo UA, per questo il match e' su sottostringa e non su prefisso.
UA_MATCH=facebook,meta

# URL che fbguard continua a gestire (WordPress non parte mai) ma che non
# devono MAI finire in coda: niente fetch dal cron, niente voce di cache nuova,
# nessun refresh se la voce e' scaduta. Chi le chiede riceve MISS_STATUS.
#
# Serve per gli spazi URL combinatori: le pagine filtro tipo
# /brand/x/categorie-a-or-b-or-c/ sono di fatto infinite, nessuno ci fa
# campagne, ma uno scraper le esplora una combinazione alla volta e la cache
# cresce senza limite.
#
# Confronto per SOTTOSTRINGA sul path, case-insensitive, separate da virgola.
# Vuoto = disattivato. Esempio: NOQUEUE_PATHS=-or-,?filtering=
#
# Le voci gia' accumulate prima dell'esclusione restano: per liberarle
#   php fbguard-cron.php --purge-noqueue --dry-run   (mostra cosa toglierebbe)
#   php fbguard-cron.php --purge-noqueue
NOQUEUE_PATHS=

# Percorsi che allo scraper non servono e che a noi costano una sessione:
# rispondiamo 403 senza far partire WordPress.
EXCLUDE_PATHS=/wp-admin,/wp-login.php,/wp-json,/wp-cron.php,/xmlrpc.php,/cart,/carrello,/checkout,/my-account,/mio-account,/order-received,/lost-password

# ------------------------------------------------------------------
# Comportamento sul miss
# ------------------------------------------------------------------

# Cosa rispondere quando la pagina non e' ancora in cache.
# 503 e' la scelta giusta: Meta ripassa e non si congela un'anteprima
# sbagliata. Un 200 con contenuto finto resterebbe nella cache di Facebook
# per settimane.
MISS_STATUS=503
RETRY_AFTER=120

# ------------------------------------------------------------------
# Coda e worker
# ------------------------------------------------------------------

# Tetto ai job in coda: oltre questo le nuove URL vengono scartate, cosi'
# un flood di URL casuali non riempie il disco.
MAX_QUEUE=5000

# Quante pagine scarica al massimo ogni giro di cron.
MAX_PER_RUN=40

# Tentativi prima di arrendersi su un errore transitorio (5xx, timeout).
MAX_TRIES=3

# Pausa fra una fetch e l'altra, in millisecondi. E' la manopola con cui
# decidi quanto carico dare all'origin.
SLEEP_MS=250

FETCH_TIMEOUT=20
CONNECT_TIMEOUT=10

# ------------------------------------------------------------------
# Purge
# ------------------------------------------------------------------

# Chiave per svuotare la cache via query string. Vuota = purge disattivato.
#   https://sito.it/prodotto/xyz/?fbguard_purge=CHIAVE
#   https://sito.it/?fbguard_purge=CHIAVE&all=1
PURGE_KEY=

# ------------------------------------------------------------------
# Log
# ------------------------------------------------------------------

LOG=1
LOG_MAX_BYTES=5242880
