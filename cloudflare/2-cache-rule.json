{
  "rules": [
    {
      "description": "fbguard - cache edge delle risposte per scraper Meta",
      "expression": "http.request.uri.path contains \"/__fbguard\"",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "respect_origin"
        },
        "browser_ttl": {
          "mode": "respect_origin"
        },
        "cache_key": {
          "custom_key": {
            "query_string": {
              "exclude": {
                "all": true
              }
            }
          }
        }
      },
      "enabled": true
    }
  ]
}